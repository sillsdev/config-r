{
  "name": "@sillsdev/config-r",
  "version": "0.0.3",
  "license": "MIT",
  "keywords": [
    "react",
    "settings"
  ],
  "repository": {
    "url": "git+https://github.com/sillsdev/config-r.git"
  },
  "scripts": {
    "dev": "start http://localhost:5173 && vite",
    "// see https://github.com/vitejs/vite/issues/3461, this uses a totally different builder that has its typescript typings act more together than vitejs": "",
    "build": "tsc && vite build",
    "build:dev": "tsc && vite build --mode development --minify false --sourcemap true --watch",
    "serve": "vite preview",
    "lint:fix": "eslint ./src --ext .jsx,.js,.ts,.tsx --quiet --fix --ignore-path ./.gitignore",
    "lint:format": "prettier --log-level warn --write \"./**/*.{js,jsx,ts,tsx,css,md,json}\"",
    "lint": "pnpm lint:format && pnpm lint:fix ",
    "prepare": "simple-git-hooks",
    "type-check": "tsc",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@textea/json-viewer": "2.13.1",
    "formik": "2.2.9",
    "formik-mui": "4.0.0",
    "lodash": "4.18.1",
    "mark.js": "8.11.1",
    "react-children-utilities": "2.8.0"
  },
  "peerDependencies": {
    "@emotion/react": ">= 11.8.2 < 12",
    "@emotion/styled": ">= 11.8.1 < 12",
    "@mui/icons-material": "5.x",
    "@mui/material": ">= 5.5.3 < 6",
    "react": ">= 17.0.2 < 19",
    "react-dom": ">= 17.0.2 < 19"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@emotion/babel-plugin": "11.13.5",
    "@emotion/eslint-plugin": "11.12.0",
    "@emotion/react": "11.10.6",
    "@emotion/styled": "11.10.6",
    "@mui/icons-material": "5.11.9",
    "@mui/material": "5.11.10",
    "@storybook/addon-actions": "8.6.19",
    "@storybook/addon-essentials": "8.6.19",
    "@storybook/addon-links": "8.6.19",
    "@storybook/builder-vite": "8.6.19",
    "@storybook/react": "8.6.19",
    "@storybook/react-vite": "8.6.19",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/lodash": "4.17.26",
    "@types/mark.js": "8.11.12",
    "@types/react": "18.0.28",
    "@types/react-color": "3.0.13",
    "@types/react-dom": "18.0.11",
    "@typescript-eslint/eslint-plugin": "5.53.0",
    "@typescript-eslint/parser": "5.53.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "8.34.0",
    "eslint-config-prettier": "8.6.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "4.2.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-simple-import-sort": "10.0.0",
    "eslint-plugin-storybook": "0.8.0",
    "jsdom": "25.0.1",
    "prettier": "3.9.10",
    "react": "18.2.0",
    "react-color": "2.19.3",
    "react-dom": "18.2.0",
    "rollup-plugin-copy": "3.5.0",
    "semantic-release": "25.0.9",
    "simple-git-hooks": "2.14.0",
    "storybook": "8.6.19",
    "typescript": "5.5.4",
    "vite": "6.4.4",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.1.12"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint"
  },
  "files": [
    "dist"
  ],
  "module": "./dist/configr.es.js",
  "main": "./dist/configr.cjs.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/configr.es.js",
      "require": "./dist/configr.cjs.js",
      "default": "./dist/configr.es.js"
    }
  },
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.33.0",
  "volta": {
    "node": "24.14.0",
    "pnpm": "10.33.0"
  },
  "type": "module"
}
