{
  "name": "@sillsdev/config-r",
  "version": "0.0.3",
  "license": "MIT",
  "keywords": [
    "react",
    "settings"
  ],
  "repository": {
    "url": "git+https://github.com/sillsdev/config-r.git"
  },
  "scripts": {
    "dev": "vp dev",
    "// run tsc first so the emitted .d.ts typings are accurate; see https://github.com/vitejs/vite/issues/3461": "",
    "build": "tsc && vp build",
    "build:dev": "tsc && vp build --mode development --minify false --sourcemap true --watch",
    "serve": "vp preview",
    "format": "vp fmt \"./**/*.{js,jsx,ts,tsx,css,md,json}\"",
    "lint": "vp lint",
    "check": "vp check",
    "test": "vp test",
    "type-check": "tsc",
    "prepare": "vp config --no-agent",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@textea/json-viewer": "2.13.1",
    "formik": "2.2.9",
    "formik-mui": "4.0.0",
    "lodash": "4.17.21",
    "mark.js": "8.11.1",
    "react-children-utilities": "2.8.0"
  },
  "peerDependencies": {
    "@emotion/react": ">= 11.8.2 < 12",
    "@emotion/styled": ">= 11.8.1 < 12",
    "@mui/icons-material": "5.x",
    "@mui/material": ">= 5.5.3 < 6",
    "react": ">= 17.0.2 < 19",
    "react-dom": ">= 17.0.2 < 19"
  },
  "devDependencies": {
    "@babel/core": "7.21.0",
    "@emotion/babel-plugin": "11.10.6",
    "@emotion/react": "11.10.6",
    "@emotion/styled": "11.10.6",
    "@mui/icons-material": "5.11.9",
    "@mui/material": "5.11.10",
    "@semantic-release/changelog": "6.0.2",
    "@semantic-release/commit-analyzer": "9.0.2",
    "@storybook/addon-actions": "8.2.8",
    "@storybook/addon-essentials": "8.2.8",
    "@storybook/addon-links": "8.2.8",
    "@storybook/builder-vite": "8.2.8",
    "@storybook/react": "8.2.8",
    "@storybook/react-vite": "8.2.8",
    "@types/lodash": "4.14.191",
    "@types/mark.js": "8.11.8",
    "@types/react": "18.0.28",
    "@types/react-color": "3.0.6",
    "@types/react-dom": "18.0.11",
    "@vitejs/plugin-react": "6.0.3",
    "babel-loader": "8.3.0",
    "react": "18.2.0",
    "react-color": "2.19.3",
    "react-dom": "18.2.0",
    "rollup-plugin-copy": "3.5.0",
    "semantic-release": "25.0.3",
    "storybook": "8.2.8",
    "typescript": "5.5.4",
    "vite": "8.1.2",
    "vite-plugin-dts": "4.3.0",
    "vite-plus": "0.2.1"
  },
  "files": [
    "dist"
  ],
  "module": "./dist/configr.es.js",
  "main": "./dist/configr.cjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/configr.es.js",
      "require": "./dist/configr.cjs",
      "default": "./dist/configr.es.js"
    }
  },
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.33.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.18.0",
      "onFail": "download"
    }
  },
  "type": "module"
}
